      <artikel bwb-ng-variabel-deel="/Artikel1" stam-id="17212153" versie-id="30313282" id="C43486001" label-id="17117864" inwerking="2024-09-03" label="Artikel 1" bron="Stcrt.2024-27038" effect="nieuwe-regeling" publicatie_bron="2024-09-02" publicatie_iwt="2024-09-02" status="goed">
  <kop>
